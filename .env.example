# =============================================================================
# AI Builder LMS & Presensi — Contoh Variabel Lingkungan (.env.example)
# Stack: Vercel (hosting) + Supabase (Postgres, Auth, Storage)
# -----------------------------------------------------------------------------
# PERINGATAN KEAMANAN:
#   - Berkas ini HANYA berisi PLACEHOLDER. Salin ke `.env.local` lalu isi nilai
#     asli. `.env.local` TIDAK boleh di-commit (lihat .gitignore).
#   - Semua variabel di bawah HANYA dibaca di sisi server. JANGAN beri prefix
#     NEXT_PUBLIC_ pada nilai rahasia (akan terkirim ke browser).
#   - Di Vercel, isi lewat Project Settings > Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Postgres
# Runtime memakai role least-privilege `app_runtime` lewat Supavisor pooler mode
# TRANSACTION (port 6543). Username pooler berformat `app_runtime.<project-ref>`.
# Migrasi dijalankan terpisah lewat koneksi langsung port 5432 (lihat
# docs/DEPLOY_VERCEL_SUPABASE.md), bukan lewat URL ini.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://app_runtime.__PROJECT_REF__:__PASSWORD__@aws-0-__REGION__.pooler.supabase.com:6543/postgres"
# (Opsional) PEM "Supabase Root 2021 CA" untuk verifikasi TLS penuh.
# DATABASE_CA_CERT=""
# (Opsional) maksimum koneksi per instance; default 1 di Vercel, 10 di lokal.
# DATABASE_POOL_MAX="1"

# -----------------------------------------------------------------------------
# Supabase Auth (Dashboard > Project Settings > API Keys)
# SUPABASE_SERVICE_ROLE_KEY adalah kunci "secret"/service_role: melewati RLS
# Supabase dan dapat membuat/menghapus user. JANGAN pernah ke klien.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://__PROJECT_REF__.supabase.co"
SUPABASE_ANON_KEY="__SUPABASE_PUBLISHABLE_OR_ANON_KEY__"
SUPABASE_SERVICE_ROLE_KEY="__SUPABASE_SECRET_OR_SERVICE_ROLE_KEY__"

# -----------------------------------------------------------------------------
# Supabase Storage (endpoint S3-compatible)
# Dashboard > Storage > S3 Connection > New access key.
# Nama env sengaja tidak berawalan AWS_ (dicadangkan Vercel).
# -----------------------------------------------------------------------------
SUPABASE_S3_ACCESS_KEY_ID="__S3_ACCESS_KEY_ID__"
SUPABASE_S3_SECRET_ACCESS_KEY="__S3_SECRET_ACCESS_KEY__"
# Region project Supabase (lihat Dashboard > S3 Connection).
SUPABASE_S3_REGION="ap-southeast-1"
# (Opsional) default: ${SUPABASE_URL}/storage/v1/s3
# SUPABASE_S3_ENDPOINT=""
# Bucket: privat (materi, foto sesi) dan publik (galeri, showcase).
S3_PRIVATE_BUCKET="private-assets"
S3_PUBLIC_BUCKET="public-showcase"
# (Opsional) basis URL publik kustom/CDN. Default:
# ${SUPABASE_URL}/storage/v1/object/public/<bucket>
# S3_PUBLIC_BASE_URL=""
